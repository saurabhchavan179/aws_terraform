# ==============================================================================
# Terraform Gitignore
# ==============================================================================

# Local .terraform directory (contains downloaded provider binaries and modules)
**/.terraform/*

# .tfstate files (contains managed infrastructure state and potentially secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (usually contain environment-specific secrets/passwords)
*.tfvars
*.tfvars.json

# Ignore override files (used for quick local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you *do* wish to add to version control (negated pattern)
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan outputs generated by 'terraform plan -out=tfplan'
*tfplan*
C:\aws_terraform\Day-04\file-provisioner\.terraform.lock.hcl
C:\aws_terraform\Day-04\file-provisioner\custom-key.pem
C:\aws_terraform\Day-04\file-provisioner\custom-key.pub
C:\aws_terraform\Day-04\local-provisioner\.terraform.lock.hcl
C:\aws_terraform\Day-04\local-provisioner\custom-key.pem
C:\aws_terraform\Day-04\local-provisioner\custom-key.pub
C:\aws_terraform\Day-02\.terraform.lock.hcl